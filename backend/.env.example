# MongoDB Compass local connection (default). Change if using MongoDB Atlas.
MONGO_URI=mongodb://127.0.0.1:27017/uzhavan_sandhai

# Server
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret_key
JWT_EXPIRE=30d

# OTP delivery
# Dev mode (default): the OTP is printed to the backend terminal instead of
# sent via SMS - zero setup needed for local testing.
# To send REAL SMS OTPs to the buyer's mobile for free:
#   1. Sign up free at https://www.fast2sms.com (free credits on signup, no
#      DLT/template registration needed for the "otp" route, India numbers only).
#   2. Copy your API key from Dev API in the dashboard and paste it below.
#   3. Set OTP_DEV_MODE=false
OTP_DEV_MODE=true
FAST2SMS_API_KEY=

# Cloudinary (optional - used only if you want cloud image storage instead of local /uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Maps (optional - used on the frontend for the "Get Directions" link/embed)
GOOGLE_MAPS_API_KEY=
